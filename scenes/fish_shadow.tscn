[node name="ScareArea" type="Area3D" parent="."]
editor_description = "A Player who swims this close scares the fish off. On no layer, so neither a round nor the crosshair can find it; it only watches for Players (layer 1). Counter-scaled so the flat shadow does not squash the sphere."
transform = Transform3D(1.6666666, 0, 0, 0, 12.5, 0, 0, 0, 3.3333333, 0, 0, 0)
collision_layer = 0
monitorable = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="ScareArea"]
shape = SubResource("SphereShape3D_scare")

[node name="ShootArea" type="Area3D" parent="."]
editor_description = "The fish itself, the size of the shadow, on the projectile layer so a round or an arrow can ruin it. FishShadows disables its shape while the shadow is hidden. Counter-scaled like ScareArea."
transform = Transform3D(1.6666666, 0, 0, 0, 12.5, 0, 0, 0, 3.3333333, 0, 0, 0)
collision_mask = 0
monitoring = false

[node name="CollisionShape3D" type="CollisionShape3D" parent="ShootArea"]
shape = SubResource("BoxShape3D_shoot")

[node name="ShadowSynchronizer" type="MultiplayerSynchronizer" parent="."]
editor_description = "Carries the server's shadow to every peer: where it swims, which way it faces, how far it has sunk and whether it shows. Sent together every frame, so a shadow that comes back elsewhere never shows for a frame where it went down."
replication_config = SubResource("SceneReplicationConfig_shadow")
