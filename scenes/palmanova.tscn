[node name="Palmanova" type="Node3D" unique_id=1310274389]
editor_description = "Palmanova, the Venetian star fortress town of 1593, from OpenStreetMap and the Copernicus DEM by tools/palmanova_gis.py and tools/make_palmanova.gd, at one metre to the metre round the Piazza Grande, on an island in the weather addon's sea. Run it from the editor; the Player starts on the piazza."
script = ExtResource("1_0fggw")

