[node name="Terrain" type="Node3D" parent="."]
editor_description = "HTerrain, 2049 x 2049 at 2 m: the Copernicus DEM round the town with the works stamped on it from OpenStreetMap's walls and embankments (rampart 9 m, scarp, moat 4 m deep, ravelins and lunettes 6 m), the Piazza Grande at the origin. Slots: grass, dirt (the moat floor), rock (steep ground), brick (the scarp). Collision on the Terrain layer as well as 1."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2048.0, 0, -2048.0)
