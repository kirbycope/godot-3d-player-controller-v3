[node name="ProjectileSpawner" type="MultiplayerSpawner" parent="." unique_id=629412626 groups=["ProjectileSpawner"]]
editor_description = "Rounds, throws and drops reach every peer through here. The host spawns a client's request only for a scene on the Auto Spawn List, so it lists everything a client fires, throws or drops: the bullets and arrows (the fire and ice arrows and the incendiary round too), the fishing float, a thrown item, a dropped item's pickup and the equipment that drops as its own scene (the dagger, the fishing rod). The world's weapons drop as copies of their pickups and need no entry."
_spawnable_scenes = PackedStringArray("res://addons/3d_player_controller/scenes/projectile/bullet.tscn", "res://addons/3d_player_controller/scenes/projectile/arrow.tscn", "res://addons/3d_player_controller/scenes/projectile/thrown_item.tscn", "res://addons/3d_player_controller/inventory/scenes/item_pickup.tscn", "res://scenes/fire_arrow.tscn", "res://scenes/ice_arrow.tscn", "res://scenes/incendiary_round.tscn", "res://scenes/bobber.tscn", "res://scenes/dagger.tscn", "res://scenes/fishing_rod.tscn")
script = ExtResource("mp_projectile_spawner")

