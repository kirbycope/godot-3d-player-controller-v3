# Godot 4+ specific ignores
.godot
/android/
.DS_Store
.env
.mcp/
scratch/
*.log
wfx_*.txt
screenshot_*.png
screenshot_*.png.import
*.TMP

# Python bytecode caches from the scripts in tools/
__pycache__/
*.pyc

# Clones of the addon repositories, filled by tools/pull_addons.py.
.addon_cache/

# Fetched by tools/pull_addons.py and never committed here, third-party ones included.
addons/3d_player_controller/
addons/controls/
addons/date_and_time/
addons/godot_doom_gdextension/
addons/gta/
addons/radi_ot/
addons/tcps/
addons/weather_fx/
addons/gut/
addons/dialogic/
addons/GPUTrail/
addons/midi/
addons/godotsteam/

# The web export is built by .github/workflows/pages.yml and handed to Pages, never committed.
build/
docs/

# Results of the two-machine Steam run, tools/steam_test.py; local only.
.steam_test/
