# Godot 4+ specific ignores
.godot
/android/
.DS_Store
.env
.mcp/
addons/godotsteam/win64/~libgodotsteam.windows.template_debug.x86_64.dll
scratch/
*.log
wfx_*.txt
screenshot_*.png
screenshot_*.png.import
*.TMP

# Python bytecode caches from the scripts in tools/
__pycache__/
*.pyc

# Clones of the addon repositories, filled by tools/pull_addons.py.
.addon_cache/

# Fetched by tools/pull_addons.py and never committed here. The third-party addons beside them
# (gut, midi, godotsteam, GPUTrail-main) are not managed by any script and stay tracked.
addons/3d_player_controller/
addons/controls/
addons/date_and_time/
addons/godot_doom_gdextension/
addons/gta/
addons/radi_ot/
addons/tcps/
addons/weather_fx/

# The web export is built by .github/workflows/pages.yml and handed to Pages, never committed.
build/
docs/
