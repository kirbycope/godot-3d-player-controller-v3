#!/bin/sh
# Stop a push of this project while an addon edited here has not been sent upstream.
#
# addons/ is git-ignored, so git itself sees nothing when an addon changes: a push of this project
# would go out with the project half of the work and leave the addon half only on this machine.
# tools/push_addons.py --dry-run is what can see it. It exits non-zero when a copy differs from its
# origin, when an addon's clone has uncommitted work or commits origin does not (SKIPPED, AHEAD), when
# a copy was pulled before origin's latest commit (BEHIND), and when anything fails or throws, so the
# exit status is the whole test. Its stderr is left alone, so a traceback is seen rather than swallowed.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass once with:  git push --no-verify

# The Mac has python3 only, with no python on PATH, so looking for python alone made this hook
# exit 0 and guard nothing there. Prefer python3 and fall back for the Windows launcher.
if command -v python3 >/dev/null 2>&1; then
    python=python3
elif command -v python >/dev/null 2>&1; then
    python=python
else
    exit 0
fi
[ -f tools/push_addons.py ] || exit 0

report=$("$python" tools/push_addons.py --dry-run)
status=$?
[ "$status" -eq 0 ] && exit 0

printf '\n' >&2
printf 'The addons are not in step with their own repositories (push_addons.py --dry-run exited %s):\n\n' "$status" >&2
printf '%s\n' "$report" >&2
printf '\n' >&2
printf 'Commit any work waiting in an addon clone, pull any addon that is BEHIND, then send the\n' >&2
printf 'addons upstream first, so the addon and the project land together:\n' >&2
printf '  %s tools/push_addons.py -m "what changed"\n\n' "$python" >&2
printf 'Or push anyway with:  git push --no-verify\n\n' >&2
exit 1
