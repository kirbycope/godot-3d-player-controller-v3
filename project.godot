; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot 3D Player Controller v3"
config/version="3.0.16"
run/main_scene="uid://dtnxqy114fjc1"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://kfdo4yimvqd0"
driver/enable_input=true

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
Steamworks="*res://addons/3d_player_controller/scripts/steamworks.gd"

[debug]

file_logging/enable_file_logging=true

[dialogic]

directories/dch_directory={
"guide": "res://resources/dialogues/guide.dch"
}
directories/dtl_directory={
"qa_guide": "res://resources/dialogues/qa_guide.dtl"
}
layout/style_directory={}

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[editor_plugins]

enabled=PackedStringArray("res://addons/3d_player_controller/plugin.cfg", "res://addons/controls/plugin.cfg", "res://addons/date_and_time/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/godotsteam/plugin.cfg", "res://addons/gta/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/midi/plugin.cfg", "res://addons/radi_ot/plugin.cfg", "res://addons/tcps/plugin.cfg", "res://addons/weather_fx/plugin.cfg")

[importer_defaults]

texture={
&"compress/mode": 0,
&"detect_3d/compress_to": 1,
&"process/size_limit": 0
}

[input]

dialogic_default_action={
"deadzone": 0.5,
"events": [Object(InputEventKey,
