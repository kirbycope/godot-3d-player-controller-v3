[input_devices]

joypads/ignore_joypad_on_unfocused_application=true
pointing/emulate_mouse_from_touch=false

[layer_names]

3d_physics/layer_10="Weapons"
3d_physics/layer_11="Hittable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/d3d12/max_resource_descriptors=1000000
rendering_device/driver.windows="d3d12"

[shader_globals]

weather_wind_strength={
"type": "float",
"value": 0.0
}
weather_wind_direction={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
weather_precipitation_strength={
"type": "float",
"value": 0.0
}
weather_foliage_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
weather_grass_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}

[steam]

initialization/app_data/app_id=480
