; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot 3D Player Controller v3"
config/version="3.0.14"
run/main_scene="uid://dtnxqy114fjc1"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://kfdo4yimvqd0"
driver/enable_input=true

[autoload]

Steamworks="*res://addons/godotsteamkit/autoloads/steamworks.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/3d_player_controller/plugin.cfg", "res://addons/date_and_time/plugin.cfg", "res://addons/godotsteam/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/radi_ot/plugin.cfg", "res://addons/weather_fx/plugin.cfg")

[importer_defaults]

texture={
&"compress/mode": 1,
&"detect_3d/compress_to": 2,
&"process/size_limit": 1024
}

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true
pointing/emulate_mouse_from_touch=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[shader_globals]

weather_wind_strength={
"type": "float",
"value": 0.0
}
weather_wind_direction={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
weather_precipitation_strength={
"type": "float",
"value": 0.0
}
weather_foliage_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
weather_grass_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}

[steam]

initialization/app_data/app_id=480
