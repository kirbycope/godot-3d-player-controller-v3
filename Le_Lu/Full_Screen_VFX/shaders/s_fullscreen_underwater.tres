[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, depth_test_disabled, unshaded;

uniform vec2 Screen_Distortion_Speed;
uniform vec2 Screen_Distortion_Scale = vec2(1.000000, 1.000000);
uniform sampler2D Screen_Normal_Map_DIstortion : hint_normal, repeat_enable;
uniform float Screen_distortioness = 0.10000000149012;
uniform sampler2D depth_tex_frg_70 : hint_depth_texture;
uniform float DepthFog2 = 20;
uniform sampler2D SCREENTEX : source_color, hint_screen_texture;
uniform sampler2D DEPTHTEX : source_color, hint_depth_texture;
uniform sampler2D Gradient_Color1D2 : source_color, repeat_disable;
uniform float Border_distortionness : hint_range(0, 1) = 0;
uniform sampler2D Border_Mask : source_color, hint_default_transparent, repeat_disable;



void fragment() {
// Input:53
	vec2 n_out53p0 = SCREEN_UV;


// Input:52
	vec2 n_out52p0 = SCREEN_UV;


// Vector2Parameter:45
	vec2 n_out45p0 = Screen_Distortion_Speed;


// Input:44
	float n_out44p0 = TIME;


// VectorOp:46
	vec2 n_out46p0 = n_out45p0 * vec2(n_out44p0);


// UVFunc:41
	vec2 n_in41p1 = vec2(1.00000, 1.00000);
	vec2 n_out41p0 = n_out46p0 * n_in41p1 + n_out52p0;


// Vector2Parameter:43
	vec2 n_out43p0 = Screen_Distortion_Scale;


// UVFunc:42
	vec2 n_in42p2 = vec2(0.00000, 0.00000);
	vec2 n_out42p0 = (n_out41p0 - n_in42p2) * n_out43p0 + n_in42p2;


	vec4 n_out39p0;
// Texture2D:39
	n_out39p0 = texture(Screen_Normal_Map_DIstortion, n_out42p0);
	float n_out39p1 = n_out39p0.r;
	float n_out39p2 = n_out39p0.g;


// VectorCompose:47
	vec2 n_out47p0 = vec2(n_out39p1, n_out39p2);


// MultiplyAdd:55
	vec2 n_in55p1 = vec2(2.00000, 2.00000);
	vec2 n_in55p2 = vec2(-1.00000, -1.00000);
	vec2 n_out55p0 = fma(n_out47p0, n_in55p1, n_in55p2);


// FloatParameter:49
	float n_out49p0 = Screen_distortioness;


	float n_out70p0;
// LinearSceneDepth:70
	{
		float __log_depth = textureLod(depth_tex_frg_70, SCREEN_UV, 0.0).x;
	vec4 __depth_view = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __log_depth, 1.0);
		__depth_view.xyz /= __depth_view.w;
		n_out70p0 = -__depth_view.z;
	}


// FloatParameter:71
	float n_out71p0 = DepthFog2;


// FloatOp:72
	float n_out72p0 = n_out70p0 / n_out71p0;


// Clamp:73
	float n_in73p1 = 0.00000;
	float n_in73p2 = 1.00000;
	float n_out73p0 = clamp(n_out72p0, n_in73p1, n_in73p2);


// Mix:76
	float n_in76p0 = 0.00000;
	float n_out76p0 = mix(n_in76p0, n_out49p0, n_out73p0);


// VectorOp:48
	vec2 n_out48p0 = n_out55p0 * vec2(n_out76p0);


// VectorOp:54
	vec2 n_out54p0 = n_out53p0 - n_out48p0;


	vec4 n_out51p0;
// Texture2D:51
	n_out51p0 = texture(SCREENTEX, n_out54p0);


	vec4 n_out83p0;
// Texture2D:83
	n_out83p0 = texture(DEPTHTEX, n_out54p0);
	float n_out83p1 = n_out83p0.r;


	float n_out84p0;
// Expression:84
	n_out84p0 = 0.0;
	{
		vec4 upos = INV_PROJECTION_MATRIX * vec4(n_out54p0 * 2.0 - 1.0, n_out83p1, 1.0);
		n_out84p0 = -upos.z / upos.w;
	}


// FloatOp:85
	float n_out85p0 = n_out84p0 / n_out71p0;


// Clamp:86
	float n_in86p1 = 0.00000;
	float n_in86p2 = 1.00000;
	float n_out86p0 = clamp(n_out85p0, n_in86p1, n_in86p2);


	vec4 n_out79p0;
// Texture2D:79
	n_out79p0 = texture(Gradient_Color1D2, vec2(n_out86p0));
	float n_out79p4 = n_out79p0.a;


// Mix:80
	vec3 n_out80p0 = mix(vec3(n_out51p0.xyz), vec3(n_out79p0.xyz), vec3(n_out79p4));


// Input:60
	vec2 n_out60p0 = SCREEN_UV;


// FloatParameter:89
	float n_out89p0 = Border_distortionness;


// Mix:88
	vec2 n_out88p0 = mix(n_out54p0, n_out60p0, n_out89p0);


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Border_Mask, n_out88p0);
	float n_out5p4 = n_out5p0.a;


// Mix:87
	vec3 n_out87p0 = mix(n_out80p0, vec3(n_out5p0.xyz), vec3(n_out5p4));


// Output:0
	ALBEDO = n_out87p0;


}
