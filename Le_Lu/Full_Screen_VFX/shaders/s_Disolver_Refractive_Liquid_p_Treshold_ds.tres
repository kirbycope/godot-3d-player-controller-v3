[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 Screen_Distortion_Speed;
uniform vec2 Screen_Distortion_Scale = vec2(1.000000, 1.000000);
uniform sampler2D Screen_Normal_Map_DIstortion : hint_normal, repeat_enable;
uniform float Screen_distortioness = 0.10000000149012;
uniform sampler2D SCREENTEX : source_color, hint_screen_texture;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform vec2 Speed_XY;
uniform sampler2D Disolver_Texture : source_color, repeat_enable;
uniform sampler2D Color_1D_Gradient : source_color, repeat_disable;
uniform sampler2D Metallic_Texture : source_color, repeat_disable;
uniform sampler2D Texture_Roughtness : source_color, repeat_enable;
uniform sampler2D Roughtness_1D_Gradient : source_color, repeat_disable;
uniform sampler2D Normal_Texture : hint_normal, repeat_enable;
uniform float Normal_Map_Depth = 1;



void vertex() {
// GetBillboardMatrix:2
	// Node is disabled and code is not generated.
}

void fragment() {
// Input:53
	vec2 n_out53p0 = SCREEN_UV;


// Vector2Parameter:45
	vec2 n_out45p0 = Screen_Distortion_Speed;


// Input:44
	float n_out44p0 = TIME;


// VectorOp:46
	vec2 n_out46p0 = n_out45p0 * vec2(n_out44p0);


// UVFunc:41
	vec2 n_in41p1 = vec2(1.00000, 1.00000);
	vec2 n_out41p0 = n_out46p0 * n_in41p1 + UV;


// Vector2Parameter:43
	vec2 n_out43p0 = Screen_Distortion_Scale;


// UVFunc:42
	vec2 n_in42p2 = vec2(0.00000, 0.00000);
	vec2 n_out42p0 = (n_out41p0 - n_in42p2) * n_out43p0 + n_in42p2;


	vec4 n_out39p0;
// Texture2D:39
	n_out39p0 = texture(Screen_Normal_Map_DIstortion, n_out42p0);
	float n_out39p1 = n_out39p0.r;
	float n_out39p2 = n_out39p0.g;


// VectorCompose:47
	vec2 n_out47p0 = vec2(n_out39p1, n_out39p2);


// MultiplyAdd:55
	vec2 n_in55p1 = vec2(2.00000, 2.00000);
	vec2 n_in55p2 = vec2(-1.00000, -1.00000);
	vec2 n_out55p0 = fma(n_out47p0, n_in55p1, n_in55p2);


// FloatParameter:49
	float n_out49p0 = Screen_distortioness;


// VectorOp:48
	vec2 n_out48p0 = n_out55p0 * vec2(n_out49p0);


// VectorOp:54
	vec2 n_out54p0 = n_out53p0 - n_out48p0;


	vec4 n_out51p0;
// Texture2D:51
	n_out51p0 = texture(SCREENTEX, n_out54p0);


// Vector2Parameter:16
	vec2 n_out16p0 = Scale;


// UVFunc:15
	vec2 n_in15p2 = vec2(0.00000, 0.00000);
	vec2 n_out15p0 = (UV - n_in15p2) * n_out16p0 + n_in15p2;


// Vector2Parameter:21
	vec2 n_out21p0 = Speed_XY;


// Input:31
	float n_out31p0 = TIME;


// VectorOp:32
	vec2 n_out32p0 = n_out21p0 * vec2(n_out31p0);


// UVFunc:20
	vec2 n_in20p1 = vec2(1.00000, 1.00000);
	vec2 n_out20p0 = n_out32p0 * n_in20p1 + n_out15p0;


	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(Disolver_Texture, n_out20p0);
	float n_out10p1 = n_out10p0.r;


	vec4 n_out30p0;
// Texture2D:30
	n_out30p0 = texture(Color_1D_Gradient, vec2(n_out10p1));
	float n_out30p4 = n_out30p0.a;


// Input:36
	vec4 n_out36p0 = COLOR;


// VectorOp:35
	vec3 n_out35p0 = vec3(n_out30p0.xyz) * vec3(n_out36p0.xyz);


// Mix:64
	vec3 n_out64p0 = mix(vec3(n_out51p0.xyz), n_out35p0, n_out30p4);


// Reroute:28
	vec2 n_out28p0 = n_out20p0;


	vec4 n_out26p0;
// Texture2D:26
	n_out26p0 = texture(Metallic_Texture, n_out28p0);
	float n_out26p1 = n_out26p0.r;


	vec4 n_out25p0;
// Texture2D:25
	n_out25p0 = texture(Texture_Roughtness, n_out28p0);
	float n_out25p1 = n_out25p0.r;


	vec4 n_out34p0;
// Texture2D:34
	n_out34p0 = texture(Roughtness_1D_Gradient, vec2(n_out25p1));
	float n_out34p1 = n_out34p0.r;


	vec4 n_out23p0;
// Texture2D:23
	n_out23p0 = texture(Normal_Texture, n_out28p0);


// FloatParameter:37
	float n_out37p0 = Normal_Map_Depth;


// Input:4
	vec4 n_out4p0 = COLOR;
	float n_out4p4 = n_out4p0.a;


// Output:0
	ALBEDO = n_out64p0;
	ALPHA = n_out10p1;
	METALLIC = n_out26p1;
	ROUGHNESS = n_out34p1;
	NORMAL_MAP = vec3(n_out23p0.xyz);
	NORMAL_MAP_DEPTH = n_out37p0;
	ALPHA_SCISSOR_THRESHOLD = n_out4p4;


}
