[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, depth_test_disabled, unshaded;

uniform float Screen_distortioness = 0.10000000149012;
uniform vec2 Speed;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform sampler2D Texture_Noise : source_color, repeat_enable;
uniform sampler2D Mask : source_color, repeat_disable;
uniform float DistortionPower = 1;
uniform sampler2D SCREENTEX : source_color, hint_screen_texture;
uniform float ColorIntensity = 1;
uniform float Mask_power = 1;
uniform sampler2D Add_Texture : source_color, hint_default_black, repeat_disable;
uniform sampler2D Gradient_Color1D : source_color, repeat_disable;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Output:0
	VERTEX = n_out2p0;


}

void fragment() {
// Input:87
	vec2 n_out87p0 = SCREEN_UV;


// Input:53
	vec2 n_out53p0 = SCREEN_UV;


// Input:52
	vec2 n_out52p0 = SCREEN_UV;


// Reroute:82
	vec2 n_out82p0 = n_out52p0;


// VectorOp:77
	vec2 n_out77p0 = n_out53p0 + n_out82p0;


// Input:71
	vec2 n_out71p0 = SCREEN_UV;


// VectorOp:78
	vec2 n_out78p0 = n_out71p0 - n_out82p0;


// FloatParameter:49
	float n_out49p0 = Screen_distortioness;


// Input:60
	vec2 n_out60p0 = SCREEN_UV;


// Vector2Parameter:10
	vec2 n_out10p0 = Speed;


// Input:9
	float n_out9p0 = TIME;


// VectorOp:11
	vec2 n_out11p0 = n_out10p0 * vec2(n_out9p0);


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out11p0 * n_in6p1 + n_out60p0;


// Vector2Parameter:8
	vec2 n_out8p0 = Scale;


// UVFunc:7
	vec2 n_in7p2 = vec2(0.00000, 0.00000);
	vec2 n_out7p0 = (n_out6p0 - n_in7p2) * n_out8p0 + n_in7p2;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Texture_Noise, n_out7p0);
	float n_out5p1 = n_out5p0.r;


// FloatOp:84
	float n_out84p0 = n_out49p0 * n_out5p1;


// Mix:79
	vec2 n_out79p0 = mix(n_out77p0, n_out78p0, n_out84p0);


// VectorOp:83
	vec2 n_in83p1 = vec2(0.50000, 0.50000);
	vec2 n_out83p0 = n_out79p0 * n_in83p1;


// Input:91
	vec2 n_out91p0 = SCREEN_UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Mask, n_out91p0);
	float n_out3p1 = n_out3p0.r;


// FloatParameter:89
	float n_out89p0 = DistortionPower;


// FloatOp:88
	float n_out88p0 = pow(n_out3p1, n_out89p0);


// Mix:86
	vec2 n_out86p0 = mix(n_out87p0, n_out83p0, n_out88p0);


	vec4 n_out51p0;
// Texture2D:51
	n_out51p0 = texture(SCREENTEX, n_out86p0);


// FloatParameter:32
	float n_out32p0 = ColorIntensity;


// FloatParameter:75
	float n_out75p0 = Mask_power;


// FloatOp:74
	float n_out74p0 = pow(n_out3p1, n_out75p0);


// FloatOp:12
	float n_out12p0 = n_out5p1 * n_out74p0;


// Input:90
	vec2 n_out90p0 = SCREEN_UV;


	vec4 n_out34p0;
// Texture2D:34
	n_out34p0 = texture(Add_Texture, n_out90p0);
	float n_out34p1 = n_out34p0.r;


// FloatOp:35
	float n_out35p0 = n_out12p0 + n_out34p1;


	vec4 n_out30p0;
// Texture2D:30
	n_out30p0 = texture(Gradient_Color1D, vec2(n_out35p0));
	float n_out30p4 = n_out30p0.a;


// VectorOp:31
	vec3 n_out31p0 = vec3(n_out32p0) * vec3(n_out30p0.xyz);


// VectorOp:57
	vec3 n_out57p0 = vec3(n_out51p0.xyz) * n_out31p0;


// Mix:56
	vec3 n_out56p0 = mix(n_out57p0, n_out31p0, vec3(n_out30p4));


// Output:0
	ALBEDO = n_out56p0;


}
