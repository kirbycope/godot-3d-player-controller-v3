[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, depth_test_disabled, unshaded;

uniform float ColorIntensity = 1;
uniform bool Multiply_or_Substract = false;
uniform bool EnablePolarCoord = false;
uniform bool EnableTexDistortion = false;
uniform vec2 Distortion_Speed;
uniform vec2 Distortion_Scale = vec2(1.000000, 1.000000);
uniform sampler2D Distortion_Texture : source_color, repeat_enable;
uniform float DistortionIntensity = 0.02999999932945;
uniform vec2 Speed;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform sampler2D Texture_Noise : source_color, repeat_enable;
uniform sampler2D Mask : source_color, repeat_disable;
uniform sampler2D Add_Texture : source_color, hint_default_black, repeat_disable;
uniform vec2 Substract_Speed;
uniform vec2 Substract_Scale = vec2(1.000000, 1.000000);
uniform sampler2D Substract_Texture : source_color, hint_default_black, repeat_enable;
uniform sampler2D Gradient_Color1D : source_color, repeat_disable;



void fragment() {
// FloatParameter:32
	float n_out32p0 = ColorIntensity;


// BooleanParameter:15
	bool n_out15p0 = Multiply_or_Substract;


// BooleanParameter:54
	bool n_out54p0 = EnablePolarCoord;


// Input:55
	vec2 n_out55p0 = SCREEN_UV;


	vec2 n_out52p0;
// UVPolarCoord:52
	vec2 n_in52p1 = vec2(0.50000, 0.50000);
	float n_in52p2 = 1.00000;
	float n_in52p3 = 1.00000;
	{
		vec2 __dir = n_out55p0 - n_in52p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out52p0 = vec2(__radius * n_in52p2, __angle * n_in52p3);
	}


// Input:56
	vec2 n_out56p0 = SCREEN_UV;


// BooleanParameter:37
	bool n_out37p0 = EnableTexDistortion;


// Input:57
	vec2 n_out57p0 = SCREEN_UV;


// Vector2Parameter:17
	vec2 n_out17p0 = Distortion_Speed;


// Input:18
	float n_out18p0 = TIME;


// VectorOp:19
	vec2 n_out19p0 = n_out17p0 * vec2(n_out18p0);


// UVFunc:20
	vec2 n_in20p1 = vec2(1.00000, 1.00000);
	vec2 n_out20p0 = n_out19p0 * n_in20p1 + n_out57p0;


// Vector2Parameter:22
	vec2 n_out22p0 = Distortion_Scale;


// UVFunc:16
	vec2 n_in16p2 = vec2(0.00000, 0.00000);
	vec2 n_out16p0 = (n_out20p0 - n_in16p2) * n_out22p0 + n_in16p2;


	vec4 n_out23p0;
// Texture2D:23
	n_out23p0 = texture(Distortion_Texture, n_out16p0);
	float n_out23p1 = n_out23p0.r;


// FloatParameter:25
	float n_out25p0 = DistortionIntensity;


// FloatOp:24
	float n_out24p0 = n_out23p1 * n_out25p0;


	float n_out36p0;
// Switch:36
	float n_in36p2 = 0.00000;
	n_out36p0 = mix(n_in36p2, n_out24p0, float(n_out37p0));


// VectorOp:27
	vec2 n_out27p0 = n_out56p0 + vec2(n_out36p0);


	vec2 n_out53p0;
// Switch:53
	n_out53p0 = mix(n_out27p0, n_out52p0, float(n_out54p0));


// Vector2Parameter:10
	vec2 n_out10p0 = Speed;


// Input:9
	float n_out9p0 = TIME;


// VectorOp:11
	vec2 n_out11p0 = n_out10p0 * vec2(n_out9p0);


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out11p0 * n_in6p1 + n_out53p0;


// Vector2Parameter:8
	vec2 n_out8p0 = Scale;


// UVFunc:7
	vec2 n_in7p2 = vec2(0.00000, 0.00000);
	vec2 n_out7p0 = (n_out6p0 - n_in7p2) * n_out8p0 + n_in7p2;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Texture_Noise, n_out7p0);
	float n_out5p1 = n_out5p0.r;


// Input:58
	vec2 n_out58p0 = SCREEN_UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Mask, n_out58p0);
	float n_out3p1 = n_out3p0.r;
	float n_out3p2 = n_out3p0.g;


// FloatOp:12
	float n_out12p0 = n_out5p1 * n_out3p1;


// FloatOp:13
	float n_out13p0 = n_out5p1 - n_out3p2;


	float n_out14p0;
// Switch:14
	n_out14p0 = mix(n_out13p0, n_out12p0, float(n_out15p0));


// Input:59
	vec2 n_out59p0 = SCREEN_UV;


	vec4 n_out34p0;
// Texture2D:34
	n_out34p0 = texture(Add_Texture, n_out59p0);
	float n_out34p1 = n_out34p0.r;


// FloatOp:35
	float n_out35p0 = n_out14p0 + n_out34p1;


// Input:51
	vec2 n_out51p0 = SCREEN_UV;


// Vector2Parameter:49
	vec2 n_out49p0 = Substract_Speed;


// Input:48
	float n_out48p0 = TIME;


// VectorOp:50
	vec2 n_out50p0 = n_out49p0 * vec2(n_out48p0);


// UVFunc:45
	vec2 n_in45p1 = vec2(1.00000, 1.00000);
	vec2 n_out45p0 = n_out50p0 * n_in45p1 + n_out51p0;


// Vector2Parameter:47
	vec2 n_out47p0 = Substract_Scale;


// UVFunc:46
	vec2 n_in46p2 = vec2(0.00000, 0.00000);
	vec2 n_out46p0 = (n_out45p0 - n_in46p2) * n_out47p0 + n_in46p2;


	vec4 n_out42p0;
// Texture2D:42
	n_out42p0 = texture(Substract_Texture, n_out46p0);
	float n_out42p1 = n_out42p0.r;


// FloatOp:43
	float n_out43p0 = n_out35p0 - n_out42p1;


// Clamp:44
	float n_in44p1 = 0.00000;
	float n_in44p2 = 1.00000;
	float n_out44p0 = clamp(n_out43p0, n_in44p1, n_in44p2);


	vec4 n_out30p0;
// Texture2D:30
	n_out30p0 = texture(Gradient_Color1D, vec2(n_out44p0));
	float n_out30p4 = n_out30p0.a;


// VectorOp:31
	vec3 n_out31p0 = vec3(n_out32p0) * vec3(n_out30p0.xyz);


// Output:0
	ALBEDO = n_out31p0;
	ALPHA = n_out30p4;


}
