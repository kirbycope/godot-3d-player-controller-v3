[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, depth_test_disabled, unshaded;

uniform float ColorIntensity = 1;
uniform bool Use_manual_control_edge;
uniform float Edge_vanish_manual : hint_range(0.00999999977648, 1) = 0;
uniform float BlinkingSpeed = 10;
uniform float Blinking_min = 0;
uniform float Blinking_max = 0.5;
uniform vec2 Speed;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform sampler2D Texture_Noise : source_color, repeat_enable;
uniform sampler2D Add_Texture : source_color, hint_default_black, repeat_disable;
uniform vec2 Mask_Speed;
uniform vec2 Mask_Scale = vec2(1.000000, 1.000000);
uniform sampler2D Mask : source_color, repeat_enable;
uniform sampler2D Mask2_texture : source_color, repeat_disable;
uniform sampler2D Gradient_Color1D : source_color, repeat_disable;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Output:0
	VERTEX = n_out2p0;


}

void fragment() {
// FloatParameter:32
	float n_out32p0 = ColorIntensity;


// BooleanParameter:66
	bool n_out66p0 = Use_manual_control_edge;


// FloatParameter:64
	float n_out64p0 = Edge_vanish_manual;


// Input:57
	float n_out57p0 = TIME;


// FloatParameter:61
	float n_out61p0 = BlinkingSpeed;


// FloatOp:60
	float n_out60p0 = n_out57p0 * n_out61p0;


// FloatFunc:58
	float n_out58p0 = cos(n_out60p0);


// FloatParameter:63
	float n_out63p0 = Blinking_min;


// FloatParameter:62
	float n_out62p0 = Blinking_max;


	float n_out59p0;
// Remap:59
	float n_in59p1 = -1.00000;
	float n_in59p2 = 1.00000;
	{
		float __input_range = n_in59p2 - n_in59p1;
		float __output_range = n_out62p0 - n_out63p0;
		n_out59p0 = n_out63p0 + __output_range * ((n_out58p0 - n_in59p1) / __input_range);
	}


	float n_out65p0;
// Switch:65
	n_out65p0 = mix(n_out59p0, n_out64p0, float(n_out66p0));


// Input:78
	vec2 n_out78p0 = SCREEN_UV;


// Vector2Parameter:10
	vec2 n_out10p0 = Speed;


// Input:9
	float n_out9p0 = TIME;


// VectorOp:11
	vec2 n_out11p0 = n_out10p0 * vec2(n_out9p0);


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out11p0 * n_in6p1 + n_out78p0;


// Vector2Parameter:8
	vec2 n_out8p0 = Scale;


// UVFunc:7
	vec2 n_in7p2 = vec2(0.00000, 0.00000);
	vec2 n_out7p0 = (n_out6p0 - n_in7p2) * n_out8p0 + n_in7p2;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Texture_Noise, n_out7p0);
	float n_out5p1 = n_out5p0.r;


// Input:79
	vec2 n_out79p0 = SCREEN_UV;


	vec4 n_out34p0;
// Texture2D:34
	n_out34p0 = texture(Add_Texture, n_out79p0);
	float n_out34p1 = n_out34p0.r;


// FloatOp:35
	float n_out35p0 = n_out5p1 + n_out34p1;


// Input:80
	vec2 n_out80p0 = SCREEN_UV;


// Vector2Parameter:68
	vec2 n_out68p0 = Mask_Speed;


// Input:69
	float n_out69p0 = TIME;


// VectorOp:70
	vec2 n_out70p0 = n_out68p0 * vec2(n_out69p0);


// UVFunc:71
	vec2 n_in71p1 = vec2(1.00000, 1.00000);
	vec2 n_out71p0 = n_out70p0 * n_in71p1 + n_out80p0;


// Vector2Parameter:73
	vec2 n_out73p0 = Mask_Scale;


// UVFunc:67
	vec2 n_in67p2 = vec2(0.00000, 0.00000);
	vec2 n_out67p0 = (n_out71p0 - n_in67p2) * n_out73p0 + n_in67p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Mask, n_out67p0);
	float n_out3p1 = n_out3p0.r;


// FloatOp:12
	float n_out12p0 = n_out35p0 * n_out3p1;


// Input:81
	vec2 n_out81p0 = SCREEN_UV;


	vec4 n_out75p0;
// Texture2D:75
	n_out75p0 = texture(Mask2_texture, n_out81p0);
	float n_out75p1 = n_out75p0.r;


// FloatOp:76
	float n_out76p0 = n_out12p0 * n_out75p1;


// Step:52
	float n_out52p0 = step(n_out65p0, n_out76p0);


	vec4 n_out30p0;
// Texture2D:30
	n_out30p0 = texture(Gradient_Color1D, vec2(n_out52p0));
	float n_out30p4 = n_out30p0.a;


// VectorOp:31
	vec3 n_out31p0 = vec3(n_out32p0) * vec3(n_out30p0.xyz);


// Output:0
	ALBEDO = n_out31p0;
	ALPHA = n_out30p4;


}
