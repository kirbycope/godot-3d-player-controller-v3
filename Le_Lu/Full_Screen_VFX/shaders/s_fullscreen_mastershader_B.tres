[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, depth_test_disabled, unshaded;

uniform vec2 Screen_Distortion_Speed;
uniform vec2 Screen_Distortion_Scale = vec2(1.000000, 1.000000);
uniform sampler2D Screen_Normal_Map_DIstortion : hint_normal, repeat_enable;
uniform float Screen_distortioness = 0.10000000149012;
uniform sampler2D SCREENTEX : source_color, hint_screen_texture;
uniform float ColorIntensity = 1;
uniform bool EnableTexOverDistortion = false;
uniform vec2 Speed;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform sampler2D Texture_Noise : source_color, repeat_enable;
uniform sampler2D Mask : source_color, repeat_disable;
uniform sampler2D Add_Texture : source_color, hint_default_black, repeat_disable;
uniform sampler2D Gradient_Color1D : source_color, repeat_disable;



void fragment() {
// Input:53
	vec2 n_out53p0 = SCREEN_UV;


// Input:52
	vec2 n_out52p0 = SCREEN_UV;


// Vector2Parameter:45
	vec2 n_out45p0 = Screen_Distortion_Speed;


// Input:44
	float n_out44p0 = TIME;


// VectorOp:46
	vec2 n_out46p0 = n_out45p0 * vec2(n_out44p0);


// UVFunc:41
	vec2 n_in41p1 = vec2(1.00000, 1.00000);
	vec2 n_out41p0 = n_out46p0 * n_in41p1 + n_out52p0;


// Vector2Parameter:43
	vec2 n_out43p0 = Screen_Distortion_Scale;


// UVFunc:42
	vec2 n_in42p2 = vec2(0.00000, 0.00000);
	vec2 n_out42p0 = (n_out41p0 - n_in42p2) * n_out43p0 + n_in42p2;


	vec4 n_out39p0;
// Texture2D:39
	n_out39p0 = texture(Screen_Normal_Map_DIstortion, n_out42p0);
	float n_out39p1 = n_out39p0.r;
	float n_out39p2 = n_out39p0.g;


// VectorCompose:47
	vec2 n_out47p0 = vec2(n_out39p1, n_out39p2);


// MultiplyAdd:55
	vec2 n_in55p1 = vec2(2.00000, 2.00000);
	vec2 n_in55p2 = vec2(-1.00000, -1.00000);
	vec2 n_out55p0 = fma(n_out47p0, n_in55p1, n_in55p2);


// FloatParameter:49
	float n_out49p0 = Screen_distortioness;


// VectorOp:48
	vec2 n_out48p0 = n_out55p0 * vec2(n_out49p0);


// VectorOp:54
	vec2 n_out54p0 = n_out53p0 - n_out48p0;


	vec4 n_out51p0;
// Texture2D:51
	n_out51p0 = texture(SCREENTEX, n_out54p0);


// FloatParameter:32
	float n_out32p0 = ColorIntensity;


// BooleanParameter:59
	bool n_out59p0 = EnableTexOverDistortion;


// Input:60
	vec2 n_out60p0 = SCREEN_UV;


	vec2 n_out58p0;
// Switch:58
	n_out58p0 = mix(n_out60p0, n_out54p0, float(n_out59p0));


// Vector2Parameter:10
	vec2 n_out10p0 = Speed;


// Input:9
	float n_out9p0 = TIME;


// VectorOp:11
	vec2 n_out11p0 = n_out10p0 * vec2(n_out9p0);


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out11p0 * n_in6p1 + n_out58p0;


// Vector2Parameter:8
	vec2 n_out8p0 = Scale;


// UVFunc:7
	vec2 n_in7p2 = vec2(0.00000, 0.00000);
	vec2 n_out7p0 = (n_out6p0 - n_in7p2) * n_out8p0 + n_in7p2;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Texture_Noise, n_out7p0);
	float n_out5p1 = n_out5p0.r;


// Input:70
	vec2 n_out70p0 = SCREEN_UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Mask, n_out70p0);
	float n_out3p1 = n_out3p0.r;


// FloatOp:12
	float n_out12p0 = n_out5p1 * n_out3p1;


	vec4 n_out34p0;
// Texture2D:34
	n_out34p0 = texture(Add_Texture, n_out70p0);
	float n_out34p1 = n_out34p0.r;


// FloatOp:35
	float n_out35p0 = n_out12p0 + n_out34p1;


	vec4 n_out30p0;
// Texture2D:30
	n_out30p0 = texture(Gradient_Color1D, vec2(n_out35p0));
	float n_out30p4 = n_out30p0.a;


// VectorOp:31
	vec3 n_out31p0 = vec3(n_out32p0) * vec3(n_out30p0.xyz);


// VectorOp:57
	vec3 n_out57p0 = vec3(n_out51p0.xyz) * n_out31p0;


// Mix:56
	vec3 n_out56p0 = mix(n_out57p0, n_out31p0, vec3(n_out30p4));


// Output:0
	ALBEDO = n_out56p0;


}
