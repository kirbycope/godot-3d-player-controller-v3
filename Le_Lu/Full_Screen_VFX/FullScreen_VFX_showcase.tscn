[sub_resource type="GDScript" id="GDScript_3pnxd"]
resource_name = "vfx_showcaser_screeneffects"
script/source = "@tool
extends Node


@export var my_num:int = 0:
	set(new_my_num):
		my_num = new_my_num
		self.play_all_animations(my_num)

@export var screen_vfx :Array[MeshInstance3D]

func _ready() -> void:
	$map_stuff/AnimationPlayer.play("Init")

func _run():
	$map_stuff/AnimationPlayer.play("Init")

func play_all_animations(_num:int)->void:
	
	match _num:
		1:
			screen_vfx[0].find_child("AnimationPlayer").play("Start")
			screen_vfx[1].find_child("AnimationPlayer").play("Start")
			screen_vfx[2].find_child("AnimationPlayer").play("Start")
			screen_vfx[3].find_child("AnimationPlayer").play("Start")
		2:
			screen_vfx[4].visible = true
			screen_vfx[5].find_child("AnimationPlayer").play("Start")
			screen_vfx[6].find_child("AnimationPlayer").play("Start")
			screen_vfx[7].find_child("AnimationPlayer").play("Start")
		3:
			screen_vfx[8].visible = true
			screen_vfx[9].find_child("AnimationPlayer").play("Start")
			screen_vfx[10].find_child("AnimationPlayer").play("Start")
			screen_vfx[11].find_child("AnimationPlayer").play("Start")
		4:
			screen_vfx[12].find_child("AnimationPlayer").play("Start")
			screen_vfx[13].find_child("AnimationPlayer").play("Start")
			screen_vfx[14].find_child("AnimationPlayer").play("Start")
		5:
			screen_vfx[15].find_child("AnimationPlayer").play("Start")
			screen_vfx[16].find_child("AnimationPlayer").play("Start")
			screen_vfx[17].visible = true
"

