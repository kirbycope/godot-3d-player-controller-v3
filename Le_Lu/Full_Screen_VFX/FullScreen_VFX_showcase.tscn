[sub_resource type="VisualShader" id="VisualShader_r6ij3"]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 offset;
uniform vec2 scale = vec2(1.000000, 1.000000);
uniform sampler2D Base_Texture : source_color, repeat_enable;
uniform sampler2D add_Texture : source_color, repeat_disable;
uniform vec4 add_Color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform sampler2D Rought_Texture : repeat_enable;
uniform sampler2D Rought_gradient_1D : repeat_enable;
uniform float specular : hint_range(0, 1) = 0.5;
uniform sampler2D Normal_Texture : hint_normal, repeat_enable;
uniform float Normal_INtensity = 1;



void fragment() {
// Vector2Parameter:6
	vec2 n_out6p0 = offset;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out6p0 * n_in4p1 + UV;


// Vector2Parameter:7
	vec2 n_out7p0 = scale;


// UVFunc:5
	vec2 n_in5p2 = vec2(0.00000, 0.00000);
	vec2 n_out5p0 = (n_out4p0 - n_in5p2) * n_out7p0 + n_in5p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Base_Texture, n_out5p0);


	vec4 n_out9p0;
// Texture2D:9
	n_out9p0 = texture(add_Texture, UV);


// ColorParameter:11
	vec4 n_out11p0 = add_Color;


// VectorOp:10
	vec3 n_out10p0 = vec3(n_out9p0.xyz) * vec3(n_out11p0.xyz);


// VectorOp:12
	vec3 n_out12p0 = vec3(n_out3p0.xyz) + n_out10p0;


	vec4 n_out21p0;
// Texture2D:21
	n_out21p0 = texture(Rought_Texture, n_out5p0);
	float n_out21p1 = n_out21p0.r;


	vec4 n_out23p0;
// Texture2D:23
	n_out23p0 = texture(Rought_gradient_1D, vec2(n_out21p1));
	float n_out23p1 = n_out23p0.r;


// FloatParameter:22
	float n_out22p0 = specular;


	vec4 n_out17p0;
// Texture2D:17
	n_out17p0 = texture(Normal_Texture, n_out5p0);


// FloatParameter:19
	float n_out19p0 = Normal_INtensity;


// Output:0
	ALBEDO = n_out12p0;
	ROUGHNESS = n_out23p1;
	SPECULAR = n_out22p0;
	NORMAL_MAP = vec3(n_out17p0.xyz);
	NORMAL_MAP_DEPTH = n_out19p0;


}
"
