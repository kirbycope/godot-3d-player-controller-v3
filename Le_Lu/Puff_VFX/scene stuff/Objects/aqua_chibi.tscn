[ext_resource type="Texture2D" uid="uid://cy6nplrst5nxx" path="res://Le_Lu/Puff_VFX/scene stuff/Objects/aqua_chibi_Ucupaint Fan Color.png" id="2_cqnmd"]

[sub_resource type="GDScript" id="GDScript_d4waq"]
resource_name = "exampleB_smokes"
script/source = "extends Node3D

var  smoke_path:String = "res://VFX_Puff premium pack/VFX/Scenes/VFX_Puff_style_C.tscn"
@onready var smoke_res:Resource = load(smoke_path)

@onready var smoke1_pos:Vector3 = $Marker3D.global_position
@onready var smoke2_pos:Vector3 = $Marker3D2.global_position


func play_smoke1()->void:
	
	#ADD SMOKE
	var smoke1_inst:Node3D = smoke_res.instantiate()
	smoke1_inst.position = smoke1_pos
	get_parent().add_child(smoke1_inst)

	
	#WAIT 1.2 Secs.. and then...destroy the smoke
	await get_tree().create_timer(1.2).timeout
	smoke1_inst.queue_free()

func play_smoke2()->void:
	
	#ADD SMOKE
	var smoke2_inst:Node3D = smoke_res.instantiate()
	smoke2_inst.position = smoke2_pos
	get_parent().add_child(smoke2_inst)

	
	#WAIT 1.2 Secs.. and then...destroy the smoke
	await get_tree().create_timer(1.2).timeout
	smoke2_inst.queue_free()
"

