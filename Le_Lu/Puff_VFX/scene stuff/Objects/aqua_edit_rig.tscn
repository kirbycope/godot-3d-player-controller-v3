[ext_resource type="Texture2D" uid="uid://ck0kst5ohn8ar" path="res://Le_Lu/Puff_VFX/scene stuff/Objects/aqua_edit_rig_KS001_Aqua_acc_d.png" id="3_axbd7"]

[sub_resource type="GDScript" id="GDScript_wbm7u"]
resource_name = "example_smoke1"
script/source = "
extends Node3D

var  smoke_path:String = "res://VFX_Puff premium pack/VFX/Scenes/VFX_Puff_style_b.tscn"
@onready var smoke_res:Resource = load(smoke_path)
@onready var smoke_pos:Vector3 = $Marker3D.global_position

var  model2_path:String = "res://scene stuff/Objects/aqua_chibi.tscn"
@onready var model2_res:Resource = load(model2_path)




func play_smoke()->void:
	
	#ADD SMOKE
	var smoke_inst:Node3D = smoke_res.instantiate()
	smoke_inst.position = smoke_pos
	get_parent().add_child(smoke_inst)
	
	#ADD Model 2
	var model2_inst:Node3D = model2_res.instantiate()
	get_parent().add_child(model2_inst)
	
	#WAIT 0.2 Secs.. and then...
	await get_tree().create_timer(0.2).timeout
	
	#Destroy this node
	self.queue_free()
	
"

