[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform bool Texture_As_Multiply;
uniform bool Fresnel_Invert;
uniform float Fresnel_power = 1;
uniform bool Use_UV2 = false;
uniform vec2 Texture_Scale_XY = vec2(1.000000, 1.000000);
uniform vec2 Texture_Speed_XY;
uniform sampler2D Texture : source_color, hint_default_black, repeat_enable;
uniform float Texture_Power = 1;
uniform sampler2D Color1DGradient : source_color, repeat_disable;
uniform float Opacity : hint_range(0, 1) = 1;



void fragment() {
// BooleanParameter:17
	bool n_out17p0 = Texture_As_Multiply;


// BooleanParameter:3
	bool n_out3p0 = Fresnel_Invert;


// FloatParameter:4
	float n_out4p0 = Fresnel_power;


// Fresnel:2
	float n_out2p0 = n_out3p0 ? (pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out4p0)) : (pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out4p0));


// BooleanParameter:24
	bool n_out24p0 = Use_UV2;


// Input:22
	vec2 n_out22p0 = UV2;


// Input:21
	vec2 n_out21p0 = UV;


	vec2 n_out25p0;
// Switch:25
	n_out25p0 = mix(n_out21p0, n_out22p0, float(n_out24p0));


// Vector2Parameter:15
	vec2 n_out15p0 = Texture_Scale_XY;


// UVFunc:11
	vec2 n_in11p2 = vec2(0.00000, 0.00000);
	vec2 n_out11p0 = (n_out25p0 - n_in11p2) * n_out15p0 + n_in11p2;


// Input:12
	float n_out12p0 = TIME;


// Vector2Parameter:13
	vec2 n_out13p0 = Texture_Speed_XY;


// VectorOp:14
	vec2 n_out14p0 = vec2(n_out12p0) * n_out13p0;


// UVFunc:10
	vec2 n_in10p1 = vec2(1.00000, 1.00000);
	vec2 n_out10p0 = n_out14p0 * n_in10p1 + n_out11p0;


	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Texture, n_out10p0);
	float n_out8p1 = n_out8p0.r;


// FloatParameter:20
	float n_out20p0 = Texture_Power;


// FloatOp:19
	float n_out19p0 = pow(n_out8p1, n_out20p0);


// FloatOp:9
	float n_out9p0 = n_out2p0 * n_out19p0;


// FloatOp:18
	float n_out18p0 = n_out2p0 + n_out19p0;


	float n_out16p0;
// Switch:16
	n_out16p0 = mix(n_out18p0, n_out9p0, float(n_out17p0));


	vec4 n_out27p0;
// Texture2D:27
	n_out27p0 = texture(Color1DGradient, vec2(n_out16p0));
	float n_out27p4 = n_out27p0.a;


// FloatParameter:29
	float n_out29p0 = Opacity;


// FloatOp:28
	float n_out28p0 = n_out27p4 * n_out29p0;


// Output:0
	ALBEDO = vec3(n_out27p0.xyz);
	ALPHA = n_out28p0;


}
"
