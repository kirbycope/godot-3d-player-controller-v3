code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform vec2 Speed = vec2(0.000000, 0.000000);
uniform sampler2D Texture : source_color, repeat_enable;



void vertex() {
// GetBillboardMatrix:2
	// Node is disabled and code is not generated.
}

void fragment() {
// Input:4
	vec4 n_out4p0 = COLOR;
	float n_out4p4 = n_out4p0.a;


// Vector2Parameter:16
	vec2 n_out16p0 = Scale;


// UVFunc:15
	vec2 n_in15p2 = vec2(0.00000, 0.00000);
	vec2 n_out15p0 = (UV - n_in15p2) * n_out16p0 + n_in15p2;


// Vector2Parameter:17
	vec2 n_out17p0 = Speed;


// Input:19
	float n_out19p0 = TIME;


// VectorOp:20
	vec2 n_out20p0 = n_out17p0 * vec2(n_out19p0);


// UVFunc:18
	vec2 n_in18p1 = vec2(1.00000, 1.00000);
	vec2 n_out18p0 = n_out20p0 * n_in18p1 + n_out15p0;


	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(Texture, n_out18p0);
	float n_out10p1 = n_out10p0.r;


// SmoothStep:21
	float n_in21p1 = 1.00000;
	float n_out21p0 = smoothstep(n_out4p4, n_in21p1, n_out10p1);


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);
	ALPHA = n_out21p0;


}
