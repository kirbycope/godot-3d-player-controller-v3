	}


// Fresnel:2
	float n_out2p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out9p0);


// FloatOp:17
	float n_out17p0 = n_out13p0 * n_out2p0;


// Output:0
	ALBEDO = n_out12p0;
	ALPHA = n_out17p0;


}
