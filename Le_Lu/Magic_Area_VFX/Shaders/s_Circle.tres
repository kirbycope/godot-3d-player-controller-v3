code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec2 Speed;
uniform sampler2D Texture : source_color;
uniform float Extra_Opacity = 0.0599999986589;
uniform sampler2D tex_frg_7;



void fragment() {
// Input:9
	vec4 n_out9p0 = COLOR;


// Input:4
	float n_out4p0 = TIME;


// Vector2Parameter:6
	vec2 n_out6p0 = Speed;


// VectorOp:5
	vec2 n_out5p0 = vec2(n_out4p0) * n_out6p0;


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out5p0 * n_in3p1 + UV;


	vec4 n_out12p0;
// Texture2D:12
	n_out12p0 = texture(Texture, n_out3p0);
	float n_out12p1 = n_out12p0.r;


// FloatParameter:13
	float n_out13p0 = Extra_Opacity;


// FloatOp:10
	float n_out10p0 = n_out12p1 + n_out13p0;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, UV);
	float n_out7p1 = n_out7p0.r;


// FloatOp:8
	float n_out8p0 = n_out10p0 * n_out7p1;


// Output:0
	ALBEDO = vec3(n_out9p0.xyz);
	ALPHA = n_out8p0;


}
"
