[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D tex_frg_2 : source_color;



void fragment() {
// ColorConstant:19
	vec4 n_out19p0 = vec4(0.200000, 0.500000, 2.000000, 1.000000);


// Input:3
	float n_out3p0 = TIME;


// VectorOp:4
	vec2 n_in4p1 = vec2(0.00000, -1.00000);
	vec2 n_out4p0 = vec2(n_out3p0) * n_in4p1;


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out4p0 * n_in5p1 + UV;


// VectorOp:20
	vec2 n_in20p1 = vec2(1.00000, 0.50000);
	vec2 n_out20p0 = n_out5p0 / n_in20p1;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out20p0);
	float n_out2p1 = n_out2p0.r;


// Fresnel:28
	float n_in28p3 = 5.00000;
	float n_out28p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in28p3);


// FloatOp:29
	float n_out29p0 = n_out2p1 * n_out28p0;


// FloatOp:30
	float n_in30p1 = 0.03000;
	float n_out30p0 = n_out29p0 + n_in30p1;


// Output:0
	ALBEDO = vec3(n_out19p0.xyz);
	ALPHA = n_out30p0;


}
"
