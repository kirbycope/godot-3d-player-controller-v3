[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform float blinking_speed = 1;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:4
	float n_out4p0 = TIME;


// FloatOp:7
	float n_in7p1 = 4.00000;
	float n_out7p0 = n_out4p0 * n_in7p1;


// FloatFunc:5
	float n_out5p0 = sin(n_out7p0);


// FloatOp:8
	float n_in8p1 = 1.20000;
	float n_out8p0 = n_out5p0 * n_in8p1;


// VectorCompose:6
	float n_in6p0 = 0.00000;
	float n_in6p2 = 0.00000;
	vec3 n_out6p0 = vec3(n_in6p0, n_out8p0, n_in6p2);


// VectorOp:3
	vec3 n_out3p0 = n_out2p0 + n_out6p0;


// Output:0
	VERTEX = n_out3p0;


}

void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// Input:4
	float n_out4p0 = TIME;


// FloatParameter:7
	float n_out7p0 = blinking_speed;


// FloatOp:6
	float n_out6p0 = n_out4p0 * n_out7p0;


// FloatFunc:5
	float n_out5p0 = sin(n_out6p0);


	float n_out8p0;
// Remap:8
	float n_in8p1 = -1.00000;
	float n_in8p2 = 1.00000;
	float n_in8p3 = 0.50000;
	float n_in8p4 = 1.00000;
	{
		float __input_range = n_in8p2 - n_in8p1;
		float __output_range = n_in8p4 - n_in8p3;
		n_out8p0 = n_in8p3 + __output_range * ((n_out5p0 - n_in8p1) / __input_range);
	}


// Fresnel:3
	float n_out3p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out8p0);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out3p0;


}
"
