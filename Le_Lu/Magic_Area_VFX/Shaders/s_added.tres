code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float Fresnel_Opacity : hint_range(0, 1) = 1;
uniform sampler2D tex_frg_6;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = ColorParameter;


// Fresnel:2
	float n_in2p3 = 1.00000;
	float n_out2p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in2p3);


// FloatParameter:4
	float n_out4p0 = Fresnel_Opacity;


// FloatOp:5
	float n_out5p0 = n_out2p0 * n_out4p0;


// Input:7
	vec2 n_out7p0 = UV2;


// Input:9
	float n_out9p0 = TIME;


// VectorOp:10
	vec2 n_in10p1 = vec2(0.00000, 1.00000);
	vec2 n_out10p0 = vec2(n_out9p0) * n_in10p1;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out10p0 * n_in8p1 + n_out7p0;


// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, n_out8p0);
	float n_out6p1 = n_out6p0.r;


// FloatOp:11
	float n_out11p0 = n_out5p0 * n_out6p1;


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out11p0;


}
"
