[sub_resource type="GDScript" id="GDScript_area_showcase"]
resource_name = "MagicAreaShowcase"
script/source = "@tool
extends Node

@export_enum("Healing Flower", "Blue Mana Area", "Both Areas") var selected_area: int = 0:
	set(val):
		selected_area = val
		if is_inside_tree():
			apply_selection(selected_area)

func _ready() -> void:
	_setup_camera_and_ui()
	apply_selection(selected_area)

func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_1:
			set_area(0)
		elif event.keycode == KEY_2:
			set_area(1)
		elif event.keycode == KEY_3:
			set_area(2)
		elif event.keycode == KEY_4:
			toggle_character()

func set_area(idx: int) -> void:
	selected_area = idx
	apply_selection(idx)

func toggle_character() -> void:
	var root_node := get_node_or_null("root")
	if root_node:
		root_node.visible = not root_node.visible

func apply_selection(idx: int) -> void:
	if not is_inside_tree():
		return
	
	var flower_area := get_node_or_null("VFX Flower Healing Area")
	var blue_area := get_node_or_null("Blue Arua")
	
	match idx:
		0: # Healing Flower
			if flower_area:
				flower_area.visible = true
				flower_area.position = Vector3(-1.94, 0, 0)
			if blue_area:
				blue_area.visible = false
		1: # Blue Mana Area
			if flower_area:
				flower_area.visible = false
			if blue_area:
				blue_area.visible = true
				blue_area.position = Vector3(-1.94, 0, 0)
		2: # Both Areas side by side
			if flower_area:
				flower_area.visible = true
				flower_area.position = Vector3(-5.0, 0, 0)
			if blue_area:
				blue_area.visible = true
				blue_area.position = Vector3(2.5, 0, 0)

func _setup_camera_and_ui() -> void:
	if Engine.is_editor_hint():
		return
	
	if not get_node_or_null("ShowcaseCamera"):
		var cam := Camera3D.new()
		cam.name = "ShowcaseCamera"
		cam.current = true
		cam.position = Vector3(0, 4.5, 9.0)
		cam.rotation_degrees = Vector3(-18, 0, 0)
		add_child(cam)
	
	if not get_node_or_null("ShowcaseUI"):
		var canvas := CanvasLayer.new()
		canvas.name = "ShowcaseUI"
		canvas.layer = 10
		add_child(canvas)
		
		var panel := PanelContainer.new()
		panel.anchors_preset = Control.PRESET_BOTTOM_WIDE
		panel.anchor_top = 1.0
		panel.anchor_bottom = 1.0
		panel.offset_top = -65.0
		panel.offset_bottom = -15.0
		panel.offset_left = 20.0
		panel.offset_right = -20.0
		canvas.add_child(panel)
		
		var style := StyleBoxFlat.new()
		style.bg_color = Color(0.1, 0.12, 0.18, 0.9)
		style.set_corner_radius_all(10)
		style.set_content_margin_all(8)
		panel.add_theme_stylebox_override("panel", style)
		
		var hbox := HBoxContainer.new()
		hbox.alignment = BoxContainer.ALIGNMENT_CENTER
		hbox.add_theme_constant_override("separation", 12)
		panel.add_child(hbox)
		
		var label := Label.new()
		label.text = "Magic Area Selectors:"
		label.add_theme_font_size_override("font_size", 14)
		hbox.add_child(label)
		
		var btn_flower := Button.new()
		btn_flower.text = "Healing Flower (1)"
		btn_flower.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		btn_flower.pressed.connect(func(): set_area(0))
		hbox.add_child(btn_flower)
		
		var btn_blue := Button.new()
		btn_blue.text = "Blue Mana Area (2)"
		btn_blue.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		btn_blue.pressed.connect(func(): set_area(1))
		hbox.add_child(btn_blue)
		
		var btn_both := Button.new()
		btn_both.text = "Both Areas (3)"
		btn_both.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		btn_both.pressed.connect(func(): set_area(2))
		hbox.add_child(btn_both)
		
		var btn_char := Button.new()
		btn_char.text = "Toggle Character (4)"
		btn_char.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		btn_char.pressed.connect(toggle_character)
		hbox.add_child(btn_char)
"

