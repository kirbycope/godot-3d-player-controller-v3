[sub_resource type="GDScript" id="GDScript_bvcii"]
resource_name = "preload_presentation"
script/source = "@tool
extends Node


@export var my_bool:bool = false:
	set(new_my_bool):
		my_bool = new_my_bool
		self.play_all_animations(my_bool)

var number = 0;

var anim_p : Array[AnimationPlayer] = [null,null,null,null,null,null];

func _ready() -> void:
	$map_stuff/AnimationPlayer.play("Init")
	
	anim_p[0] = $explosion_A.find_child("AnimationPlayer");
	anim_p[1] = $explosion_B.find_child("AnimationPlayer");
	anim_p[2] = $explosion_C.find_child("AnimationPlayer");
	anim_p[3] = $mini_explosion_1.find_child("AnimationPlayer");
	anim_p[4] = $mini_explosion_2.find_child("AnimationPlayer");
	anim_p[5] = $mini_explosion_soil_1.find_child("AnimationPlayer");
	
	
func _run() -> void:
	$map_stuff/AnimationPlayer.play("Init")
	
	anim_p[0] = $explosion_A.find_child("AnimationPlayer");
	anim_p[1] = $explosion_B.find_child("AnimationPlayer");
	anim_p[2] = $explosion_C.find_child("AnimationPlayer");
	anim_p[3] = $mini_explosion_1.find_child("AnimationPlayer");
	anim_p[4] = $mini_explosion_2.find_child("AnimationPlayer");
	anim_p[5] = $mini_explosion_soil_1.find_child("AnimationPlayer");

func play_all_animations(_type:bool)->void:
	
	anim_p[0] = $explosion_A.find_child("AnimationPlayer");
	anim_p[1] = $explosion_B.find_child("AnimationPlayer");
	anim_p[2] = $explosion_C.find_child("AnimationPlayer");
	anim_p[3] = $mini_explosion_1.find_child("AnimationPlayer");
	anim_p[4] = $mini_explosion_2.find_child("AnimationPlayer");
	anim_p[5] = $mini_explosion_soil_1.find_child("AnimationPlayer");
	
	match _type:
		true:
			if anim_p[number].is_playing()==false:
				anim_p[number].play("Init");
			number += 1;
			if number > 5:
				number = 0;
"

