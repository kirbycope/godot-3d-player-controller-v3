[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled;

uniform vec4 Color : source_color;
uniform bool Enable_Proximity_Fade = true;
uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform vec2 Speed = vec2(0.000000, 0.000000);
uniform sampler2D Texture_Base : source_color, hint_default_black, filter_linear, repeat_enable;
uniform bool Fresnel_invert = false;
uniform float Fresnel_power = 1;
uniform sampler2D Mask_Texture : source_color, filter_linear, repeat_enable;
uniform float Proximity_Fade = 1;
uniform sampler2D depth_tex_frg_8 : hint_depth_texture;



void fragment() {
// ColorParameter:22
	vec4 n_out22p0 = Color;


// BooleanParameter:11
	bool n_out11p0 = Enable_Proximity_Fade;


// Vector2Parameter:17
	vec2 n_out17p0 = Scale;


// UVFunc:16
	vec2 n_in16p2 = vec2(0.00000, 0.00000);
	vec2 n_out16p0 = (UV - n_in16p2) * n_out17p0 + n_in16p2;


// Input:13
	float n_out13p0 = TIME;


// Vector2Parameter:18
	vec2 n_out18p0 = Speed;


// VectorOp:14
	vec2 n_out14p0 = vec2(n_out13p0) * n_out18p0;


// UVFunc:15
	vec2 n_in15p1 = vec2(1.00000, 1.00000);
	vec2 n_out15p0 = n_out14p0 * n_in15p1 + n_out16p0;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(Texture_Base, n_out15p0);
	float n_out6p1 = n_out6p0.r;


// BooleanParameter:4
	bool n_out4p0 = Fresnel_invert;


// FloatParameter:3
	float n_out3p0 = Fresnel_power;


// Fresnel:2
	float n_out2p0 = n_out4p0 ? (pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out3p0)) : (pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out3p0));


// FloatOp:7
	float n_out7p0 = n_out6p1 * n_out2p0;


	vec4 n_out20p0;
// Texture2D:20
	n_out20p0 = texture(Mask_Texture, UV);
	float n_out20p1 = n_out20p0.r;


// FloatOp:21
	float n_out21p0 = n_out7p0 * n_out20p1;


// FloatParameter:12
	float n_out12p0 = Proximity_Fade;


	float n_out8p0;
// ProximityFade:8
	{
		float __depth_tex = texture(depth_tex_frg_8, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out8p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_out12p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatOp:9
	float n_out9p0 = n_out21p0 * n_out8p0;


	float n_out10p0;
// Switch:10
	n_out10p0 = mix(n_out21p0, n_out9p0, float(n_out11p0));


// Output:0
	ALBEDO = vec3(n_out22p0.xyz);
	ALPHA = n_out10p0;


}
"
