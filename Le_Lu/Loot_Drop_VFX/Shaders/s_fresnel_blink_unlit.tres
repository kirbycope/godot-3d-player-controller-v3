code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 Scale = vec2(1.000000, 1.000000);
uniform vec2 Velocity = vec2(0.000000, 0.000000);
uniform sampler2D Texture : source_color, repeat_enable;
uniform float Texture_Power;
uniform bool Enable_BLinking = false;
uniform float Blinking_speed = 0;
uniform float min_brightness = 0.5;
uniform float max_brightness2 = 1;
uniform bool invert_fresnel;
uniform float fresnel_power = 1;
uniform sampler2D Color_1D_Gradient : source_color, filter_linear;
uniform float Intensity;
uniform bool Enable_Proximity_Fade = false;
uniform float Proximity_Fade = 1;
uniform sampler2D depth_tex_frg_22 : hint_depth_texture;



void fragment() {
// Vector2Parameter:5
	vec2 n_out5p0 = Scale;


// UVFunc:4
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = (UV - n_in4p2) * n_out5p0 + n_in4p2;


// Input:7
	float n_out7p0 = TIME;


// Vector2Parameter:9
	vec2 n_out9p0 = Velocity;


// VectorOp:8
	vec2 n_out8p0 = vec2(n_out7p0) * n_out9p0;


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out8p0 * n_in6p1 + n_out4p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture, n_out6p0);
	float n_out3p1 = n_out3p0.r;


// FloatParameter:34
	float n_out34p0 = Texture_Power;


// FloatOp:33
	float n_out33p0 = pow(n_out3p1, n_out34p0);


// BooleanParameter:32
	bool n_out32p0 = Enable_BLinking;


// Input:13
	float n_out13p0 = TIME;


// FloatParameter:15
	float n_out15p0 = Blinking_speed;


// FloatOp:14
	float n_out14p0 = n_out13p0 * n_out15p0;


// FloatFunc:16
	float n_out16p0 = cos(n_out14p0);


// FloatParameter:20
	float n_out20p0 = min_brightness;


// FloatParameter:21
	float n_out21p0 = max_brightness2;


	float n_out17p0;
// Remap:17
	float n_in17p1 = -1.00000;
	float n_in17p2 = 1.00000;
	{
		float __input_range = n_in17p2 - n_in17p1;
		float __output_range = n_out21p0 - n_out20p0;
		n_out17p0 = n_out20p0 + __output_range * ((n_out16p0 - n_in17p1) / __input_range);
	}


	float n_out31p0;
// Switch:31
	float n_in31p2 = 1.00000;
	n_out31p0 = mix(n_in31p2, n_out17p0, float(n_out32p0));


// FloatOp:19
	float n_out19p0 = n_out33p0 * n_out31p0;


// BooleanParameter:30
	bool n_out30p0 = invert_fresnel;


// FloatParameter:29
	float n_out29p0 = fresnel_power;


// Fresnel:27
	float n_out27p0 = n_out30p0 ? (pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out29p0)) : (pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out29p0));


// FloatOp:28
	float n_out28p0 = n_out19p0 * n_out27p0;


	vec4 n_out36p0;
// Texture2D:36
	n_out36p0 = texture(Color_1D_Gradient, vec2(n_out28p0));
	float n_out36p4 = n_out36p0.a;


// FloatParameter:38
	float n_out38p0 = Intensity;


// VectorOp:37
	vec3 n_out37p0 = vec3(n_out36p0.xyz) * vec3(n_out38p0);


// BooleanParameter:39
	bool n_out39p0 = Enable_Proximity_Fade;


// FloatParameter:26
	float n_out26p0 = Proximity_Fade;


	float n_out22p0;
// ProximityFade:22
	{
		float __depth_tex = texture(depth_tex_frg_22, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out22p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_out26p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatOp:23
	float n_out23p0 = n_out36p4 * n_out22p0;


	float n_out24p0;
// Switch:24
	n_out24p0 = mix(n_out36p4, n_out23p0, float(n_out39p0));


// Output:0
	ALBEDO = n_out37p0;
	ALPHA = n_out24p0;


}
"
