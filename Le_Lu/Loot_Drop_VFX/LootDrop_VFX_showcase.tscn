[sub_resource type="GDScript" id="GDScript_upb2r"]
resource_name = "showcase_VFX_realtime"
script/source = "@tool
extends Node

enum {ANTICIPATION, HIT}

@export var my_bool:bool = false:
	set(new_my_bool):
		my_bool = new_my_bool
		self.play_all_animations(my_bool)

func _ready() -> void:
	$Misc/AnimationPlayer.play("Init")
	
func _run():
	$Misc/AnimationPlayer.play("Init")
	
func play_all_animations(_type:bool)->void:
	
	match _type:
		true:
			$VFX_LootDrop_A_white.find_child("AnimationPlayer").play("Init")
			$VFX_LootDrop_A_blue.find_child("AnimationPlayer").play("Init")
			$VFX_LootDrop_A_gold.find_child("AnimationPlayer").play("Init")

		false:
			pass;
"

