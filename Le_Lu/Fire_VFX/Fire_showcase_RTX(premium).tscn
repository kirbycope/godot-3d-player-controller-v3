[sub_resource type="GDScript" id="GDScript_us88u"]
resource_name = "vfx_showcaser_fire"
script/source = "@tool
extends Node

@export var my_num:int = 0:
	set(new_my_num):
		my_num = new_my_num
		self.play_all_animations(my_num)

func _ready() -> void:
	$misc/AnimationPlayer.play("Init")
	
func _run():
	$misc/AnimationPlayer.play("Init")

func play_all_animations(_num:int)->void:
	match _num:

		1:
			$VFX_FireHit_1.find_child("AnimationPlayer").play("Init")
			$VFX_FireHit_Blue.find_child("AnimationPlayer").play("Init")
		2:
			$VFX_FireHit_Red.find_child("AnimationPlayer").play("Init")
			$VFX_FireRing_Twisted.find_child("AnimationPlayer").play("Init")
			$VFX_FireHit_Toon.find_child("AnimationPlayer").play("Init")
		3:
			$VFX_FireTwist_Q1.find_child("AnimationPlayer").play("Init")
			$VFX_FirePop_single.find_child("AnimationPlayer").play("Init")
			$VFX_FireHit_Anime_A.find_child("AnimationPlayer").play("Init")
		4:
			$VFX_FireHit_Anime_Blue.find_child("AnimationPlayer").play("Init")
			$VFX_FireHit_Anime_Red.find_child("AnimationPlayer").play("Init")
		5:
			$VFX_FirExplosion.find_child("AnimationPlayer").play("Init")
			$VFX_FirePop_Anime_single.find_child("AnimationPlayer").play("Init")
"

