[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 Distortion_Scale_XY = vec2(1.000000, 1.000000);
uniform vec2 Distortion_Speed_XY;
uniform sampler2D Texture_Distortion : source_color, repeat_enable;
uniform float distortion_strenght = 0.10000000149012;
uniform vec2 Scale_XY = vec2(1.000000, 1.000000);
uniform vec2 Speed_XY;
uniform sampler2D Base_noise_TP : source_color;
uniform bool Fresnel_Invert = false;
uniform float Fresnel_power = 1;
uniform sampler2D Gradient_Color_1D : source_color, repeat_disable;
uniform float Color_Intensity = 1;
uniform vec2 Disolver_Scale_XY = vec2(1.000000, 1.000000);
uniform vec2 Disolver_Speed_XY;
uniform sampler2D TextureDisolver : source_color, repeat_enable;
uniform float AlphaScissorThreshold : hint_range(0, 1) = 0.20000000298023;


// TextureParameterTriplanar
	vec4 triplanar_texture(sampler2D p_sampler, vec3 p_weights, vec3 p_triplanar_pos) {
		vec4 samp = vec4(0.0);
		samp += texture(p_sampler, p_triplanar_pos.xy) * p_weights.z;
		samp += texture(p_sampler, p_triplanar_pos.xz) * p_weights.y;
		samp += texture(p_sampler, p_triplanar_pos.zy * vec2(-1.0, 1.0)) * p_weights.x;
		return samp;
	}

	uniform vec3 triplanar_scale = vec3(1.0, 1.0, 1.0);
	uniform vec3 triplanar_offset;
	uniform float triplanar_sharpness = 0.5;

	varying vec3 triplanar_power_normal;
	varying vec3 triplanar_pos;

void vertex() {
// TextureParameterTriplanar
	{
		triplanar_power_normal = pow(abs(NORMAL), vec3(triplanar_sharpness));
		triplanar_power_normal /= dot(triplanar_power_normal, vec3(1.0));
		triplanar_pos = VERTEX * triplanar_scale + triplanar_offset;
		triplanar_pos *= vec3(1.0, -1.0, 1.0);
	}
}

void fragment() {
// Input:32
	vec2 n_out32p0 = UV;


// Vector2Parameter:42
	vec2 n_out42p0 = Distortion_Scale_XY;


// UVFunc:43
	vec2 n_in43p2 = vec2(0.00000, 0.00000);
	vec2 n_out43p0 = (n_out32p0 - n_in43p2) * n_out42p0 + n_in43p2;


// Vector2Parameter:40
	vec2 n_out40p0 = Distortion_Speed_XY;


// Input:39
	float n_out39p0 = TIME;


// VectorOp:41
	vec2 n_out41p0 = n_out40p0 * vec2(n_out39p0);


// UVFunc:38
	vec2 n_in38p1 = vec2(1.00000, 1.00000);
	vec2 n_out38p0 = n_out41p0 * n_in38p1 + n_out43p0;


	vec4 n_out35p0;
// Texture2D:35
	n_out35p0 = texture(Texture_Distortion, UV);
	float n_out35p1 = n_out35p0.r;


// FloatParameter:37
	float n_out37p0 = distortion_strenght;


// FloatOp:36
	float n_out36p0 = n_out35p1 * n_out37p0;


// VectorOp:33
	vec2 n_out33p0 = n_out38p0 - vec2(n_out36p0);


// Vector2Parameter:13
	vec2 n_out13p0 = Scale_XY;


// UVFunc:9
	vec2 n_in9p2 = vec2(0.00000, 0.00000);
	vec2 n_out9p0 = (n_out33p0 - n_in9p2) * n_out13p0 + n_in9p2;


// Vector2Parameter:11
	vec2 n_out11p0 = Speed_XY;


// Input:10
	float n_out10p0 = TIME;


// VectorOp:12
	vec2 n_out12p0 = n_out11p0 * vec2(n_out10p0);


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out12p0 * n_in8p1 + n_out9p0;


// TextureParameterTriplanar:50
	vec4 n_out50p0 = triplanar_texture(Base_noise_TP, triplanar_power_normal, triplanar_pos);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Base_noise_TP, n_out8p0);
	float n_out3p1 = n_out3p0.r;


// BooleanParameter:23
	bool n_out23p0 = Fresnel_Invert;


// FloatParameter:22
	float n_out22p0 = Fresnel_power;


// Fresnel:21
	float n_out21p0 = n_out23p0 ? (pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out22p0)) : (pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out22p0));


// FloatOp:14
	float n_out14p0 = n_out3p1 + n_out21p0;


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(Gradient_Color_1D, vec2(n_out14p0));
	float n_out18p4 = n_out18p0.a;


// FloatParameter:20
	float n_out20p0 = Color_Intensity;


// VectorOp:19
	vec3 n_out19p0 = vec3(n_out18p0.xyz) * vec3(n_out20p0);


// Reroute:58
	vec2 n_out58p0 = n_out33p0;


// Vector2Parameter:56
	vec2 n_out56p0 = Disolver_Scale_XY;


// UVFunc:57
	vec2 n_in57p2 = vec2(0.00000, 0.00000);
	vec2 n_out57p0 = (n_out58p0 - n_in57p2) * n_out56p0 + n_in57p2;


// Vector2Parameter:54
	vec2 n_out54p0 = Disolver_Speed_XY;


// Input:53
	float n_out53p0 = TIME;


// VectorOp:55
	vec2 n_out55p0 = n_out54p0 * vec2(n_out53p0);


// UVFunc:52
	vec2 n_in52p1 = vec2(1.00000, 1.00000);
	vec2 n_out52p0 = n_out55p0 * n_in52p1 + n_out57p0;


	vec4 n_out48p0;
// Texture2D:48
	n_out48p0 = texture(TextureDisolver, n_out52p0);
	float n_out48p1 = n_out48p0.r;


// FloatOp:49
	float n_out49p0 = n_out18p4 * n_out48p1;


// FloatParameter:46
	float n_out46p0 = AlphaScissorThreshold;


// Output:0
	ALBEDO = n_out19p0;
	ALPHA = n_out49p0;
	ALPHA_SCISSOR_THRESHOLD = n_out46p0;


}
"
