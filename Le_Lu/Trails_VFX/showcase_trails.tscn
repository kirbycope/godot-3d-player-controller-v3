[sub_resource type="GDScript" id="GDScript_trails_showcase"]
resource_name = "TrailsShowcase"
script/source = "@tool
extends Node

@export_enum("Waifu Dual Katana", "Cyborg Oni Slash", "Himi Curado", "Fire & Blue Sword", "All Characters") var selected_trail: int = 0:
	set(val):
		selected_trail = val
		if is_inside_tree():
			apply_selection(selected_trail)

var is_autoplay: bool = false
var cycle_timer: float = 0.0

func _ready() -> void:
	_setup_camera_and_ui()
	apply_selection(selected_trail)

func _process(delta: float) -> void:
	if Engine.is_editor_hint():
		return
	if is_autoplay:
		cycle_timer += delta
		if cycle_timer >= 4.0:
			cycle_timer = 0.0
			var next_idx = (selected_trail + 1) % 4
			set_trail(next_idx)

func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		if event.keycode == KEY_1:
			set_trail(0)
		elif event.keycode == KEY_2:
			set_trail(1)
		elif event.keycode == KEY_3:
			set_trail(2)
		elif event.keycode == KEY_4:
			set_trail(3)
		elif event.keycode == KEY_5:
			set_trail(4)

func set_trail(idx: int) -> void:
	selected_trail = idx
	apply_selection(idx)

func apply_selection(idx: int) -> void:
	if not is_inside_tree():
		return
	
	var waifu := get_node_or_null("Waifu")
	var oni := get_node_or_null("Oni")
	var himi := get_node_or_null("Himi")
	var sword := get_node_or_null("FireSword")
	var cam := get_node_or_null("ShowcaseCamera") as Camera3D
	
	match idx:
		0: # Waifu
			if waifu: waifu.visible = true; waifu.position = Vector3(0, 0, 0)
			if oni: oni.visible = false
			if himi: himi.visible = false
			if sword: sword.visible = false
			if cam: cam.position = Vector3(0, 1.6, 3.8); cam.rotation_degrees = Vector3(-10, 0, 0)
		1: # Oni
			if waifu: waifu.visible = false
			if oni: oni.visible = true; oni.position = Vector3(0, 0, 0)
			if himi: himi.visible = false
			if sword: sword.visible = false
			if cam: cam.position = Vector3(0, 1.8, 4.2); cam.rotation_degrees = Vector3(-10, 0, 0)
		2: # Himi
			if waifu: waifu.visible = false
			if oni: oni.visible = false
			if himi: himi.visible = true; himi.position = Vector3(0, 0, 0)
			if sword: sword.visible = false
			if cam: cam.position = Vector3(0, 1.5, 3.6); cam.rotation_degrees = Vector3(-10, 0, 0)
		3: # Sword
			if waifu: waifu.visible = false
			if oni: oni.visible = false
			if himi: himi.visible = false
			if sword: sword.visible = true; sword.position = Vector3(0, 0.4, 0)
			if cam: cam.position = Vector3(0, 1.0, 2.4); cam.rotation_degrees = Vector3(-12, 0, 0)
		4: # All characters side-by-side
			if waifu: waifu.visible = true; waifu.position = Vector3(-4.5, 0, 0)
			if oni: oni.visible = true; oni.position = Vector3(-1.5, 0, 0)
			if himi: himi.visible = true; himi.position = Vector3(1.5, 0, 0)
			if sword: sword.visible = true; sword.position = Vector3(4.5, 0.4, 0)
			if cam: cam.position = Vector3(0, 2.5, 7.5); cam.rotation_degrees = Vector3(-14, 0, 0)

func _setup_camera_and_ui() -> void:
	if Engine.is_editor_hint():
		return
	
	if not get_node_or_null("ShowcaseCamera"):
		var cam := Camera3D.new()
		cam.name = "ShowcaseCamera"
		cam.current = true
		cam.position = Vector3(0, 1.6, 3.8)
		cam.rotation_degrees = Vector3(-10, 0, 0)
		add_child(cam)
	
	if not get_node_or_null("ShowcaseUI"):
		var canvas := CanvasLayer.new()
		canvas.name = "ShowcaseUI"
		canvas.layer = 10
		add_child(canvas)
		
		var panel := PanelContainer.new()
		panel.anchors_preset = Control.PRESET_BOTTOM_WIDE
		panel.anchor_top = 1.0
		panel.anchor_bottom = 1.0
		panel.offset_top = -65.0
		panel.offset_bottom = -15.0
		panel.offset_left = 20.0
		panel.offset_right = -20.0
		canvas.add_child(panel)
		
		var style := StyleBoxFlat.new()
		style.bg_color = Color(0.1, 0.12, 0.18, 0.9)
		style.set_corner_radius_all(10)
		style.set_content_margin_all(8)
		panel.add_theme_stylebox_override("panel", style)
		
		var hbox := HBoxContainer.new()
		hbox.alignment = BoxContainer.ALIGNMENT_CENTER
		hbox.add_theme_constant_override("separation", 10)
		panel.add_child(hbox)
		
		var label := Label.new()
		label.text = "Trail VFX Selectors:"
		label.add_theme_font_size_override("font_size", 14)
		hbox.add_child(label)
		
		var names = ["Waifu Katana (1)", "Cyborg Oni (2)", "Himi Curado (3)", "Fire Sword (4)", "All (5)"]
		for i in range(names.size()):
			var btn := Button.new()
			btn.text = names[i]
			btn.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
			var idx = i
			btn.pressed.connect(func(): set_trail(idx))
			hbox.add_child(btn)
		
		var auto_btn := Button.new()
		auto_btn.text = "Auto-Cycle: OFF"
		auto_btn.toggle_mode = true
		auto_btn.button_pressed = false
		auto_btn.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
		auto_btn.toggled.connect(func(pressed: bool):
			is_autoplay = pressed
			cycle_timer = 0.0
			auto_btn.text = "Auto-Cycle: ON" if pressed else "Auto-Cycle: OFF"
		)
		hbox.add_child(auto_btn)
"

