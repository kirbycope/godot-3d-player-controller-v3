code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, fog_disabled;

uniform vec4 Color2 : source_color;
uniform vec4 Color1 : source_color;
uniform sampler2D tex_frg_14 : source_color;
uniform sampler2D Alpha_Texture : source_color, filter_linear;



void fragment() {
// ColorParameter:22
	vec4 n_out22p0 = Color2;


// ColorParameter:9
	vec4 n_out9p0 = Color1;
	float n_out9p4 = n_out9p0.a;


// Input:26
	vec4 n_out26p0 = COLOR;
	float n_out26p1 = n_out26p0.r;
	float n_out26p4 = n_out26p0.a;


	vec2 n_out15p0;
// UVPolarCoord:15
	vec2 n_in15p1 = vec2(0.50000, 0.50000);
	float n_in15p2 = 1.00000;
	float n_in15p3 = 1.00000;
	{
		vec2 __dir = UV - n_in15p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out15p0 = vec2(__radius * n_in15p2, __angle * n_in15p3);
	}


// Texture2D:14
	vec4 n_out14p0 = texture(tex_frg_14, n_out15p0);
	float n_out14p1 = n_out14p0.r;


// FloatOp:20
	float n_in20p1 = 0.03000;
	float n_out20p0 = n_out14p1 - n_in20p1;


// Clamp:25
	float n_in25p1 = 0.00000;
	float n_in25p2 = 1.00000;
	float n_out25p0 = clamp(n_out20p0, n_in25p1, n_in25p2);


// Step:19
	float n_out19p0 = step(n_out26p1, n_out25p0);


// Mix:24
	vec3 n_out24p0 = mix(vec3(n_out22p0.xyz), vec3(n_out9p0.xyz), n_out19p0);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Alpha_Texture, UV);
	float n_out3p1 = n_out3p0.r;


// FloatOp:8
	float n_out8p0 = n_out9p4 * n_out3p1;


// Step:16
	float n_out16p0 = step(n_out26p1, n_out14p1);


// FloatOp:18
	float n_out18p0 = n_out8p0 * n_out16p0;


// FloatOp:27
	float n_out27p0 = n_out18p0 * n_out26p4;


// Output:0
	ALBEDO = n_out24p0;
	ALPHA = n_out27p0;


}
