[sub_resource type="GDScript" id="GDScript_wgxxi"]
resource_name = "VFX_Showcaser"
script/source = "@tool
extends Node

@export var my_num:int = 0:
	set(new_my_num):
		my_num = new_my_num
		self.play_all_animations(my_num)

func _ready() -> void:
	$misc/AnimationPlayer.play("Init")
	
func _run():
	$misc/AnimationPlayer.play("Init")

func play_all_animations(_num:int)->void:
	
	match _num:
		1:
			$VFX_Dark_ShadowRing.find_child("AnimationPlayer").play("Init")
			$VFX_Explosion_Electric_B.find_child("AnimationPlayer").play("Init")
		2:
			$VFX_HitMagic_Pk1.find_child("AnimationPlayer").play("Init")
			$VFX_Explosion_LovePop.find_child("AnimationPlayer").play("Init")
			$VFX_Explosion_electric_y.find_child("AnimationPlayer").play("Init")
		3:
			$VFX_Fire_Ring_Oc.find_child("AnimationPlayer").play("Init")
			$VFX_Fire_GravityRing.find_child("AnimationPlayer").play("Init")
			$VFX_MagicCircle_Pi1.find_child("AnimationPlayer").play("Init")
		
		4:
			$VFX_MagicCircle_Pk1.find_child("AnimationPlayer").play("Init")
"

