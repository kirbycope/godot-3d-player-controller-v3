[ext_resource type="Script" uid="uid://bjkst6w1fy66v" path="res://addons/3d_player_controller/scripts/dialogue.gd" id="1_dialogue"]
[ext_resource type="Script" uid="uid://b6k1rvy48el5k" path="res://addons/3d_player_controller/scripts/dialogue_line.gd" id="2_line"]
[ext_resource type="Script" uid="uid://c0ephy1ld8p0g" path="res://addons/3d_player_controller/scripts/dialogue_choice.gd" id="3_choice"]
[ext_resource type="Resource" uid="uid://d4nm2fqyvx42w" path="res://resources/quests/qa_errand.tres" id="4_quest"]

[sub_resource type="Resource" id="Resource_choice_yes"]
script = ExtResource("3_choice")
text = "What do you need?"
next = 1
starts_quest = ExtResource("4_quest")
progresses_objective = &"talk_guide"

[sub_resource type="Resource" id="Resource_choice_no"]
script = ExtResource("3_choice")
text = "Maybe later."

[sub_resource type="Resource" id="Resource_line_greeting"]
script = ExtResource("2_line")
text = "New here? Everything on this field is for trying out. I could use a hand while you are at it."
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice_yes"), SubResource("Resource_choice_no")])
condition = 1
condition_quest = ExtResource("4_quest")

[sub_resource type="Resource" id="Resource_line_task"]
script = ExtResource("2_line")
text = "Firewood and supper. Take an axe to one of the trees, then cast a line in the pool. I will make it worth your while."
ends_dialogue = true
entry = false

[sub_resource type="Resource" id="Resource_line_waiting"]
script = ExtResource("2_line")
text = "The axes are by the spawn and the rod is a walk-over pickup. The pool is south of here."
ends_dialogue = true
condition = 2
condition_quest = ExtResource("4_quest")

[sub_resource type="Resource" id="Resource_line_done"]
script = ExtResource("2_line")
text = "Wood and fish, just as asked. The apples are yours."
ends_dialogue = true
condition = 3
condition_quest = ExtResource("4_quest")

[resource]
script = ExtResource("1_dialogue")
lines = Array[ExtResource("2_line")]([SubResource("Resource_line_greeting"), SubResource("Resource_line_task"), SubResource("Resource_line_waiting"), SubResource("Resource_line_done")])
