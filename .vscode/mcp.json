{
  "servers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "godot": {
      "command": "npx",
      "args": ["-y", "godot-mcp-runtime"],
      "env": {
        "GODOT_PATH": "c:\\Godot\\godot.exe",
        "GODOT_MCP_DISABLE_ELICITATION": "true"
      }
    }
  }
}
