[gd_resource type="Resource" script_class="SpellTree" load_steps=8 format=3]

[ext_resource type="Script" path="res://addons/garp/scripts/spell_tree.gd" id="tree"]
[ext_resource type="Script" path="res://addons/garp/scripts/spell_node.gd" id="node"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/ability.gd" id="ability"]
[ext_resource type="Resource" path="res://addons/3d_player_controller/resources/abilities/stealth.tres" id="stealth"]
[ext_resource type="Resource" path="res://addons/3d_player_controller/resources/abilities/heal.tres" id="heal"]

[sub_resource type="Resource" id="n_stealth"]
script = ExtResource("node")
ability = ExtResource("stealth")
cost = 1
requires = Array[ExtResource("ability")]([])
row = 0
column = 0

[sub_resource type="Resource" id="n_heal"]
script = ExtResource("node")
ability = ExtResource("heal")
cost = 2
requires = Array[ExtResource("ability")]([ExtResource("stealth")])
row = 1
column = 0

[resource]
script = ExtResource("tree")
display_name = "Demo Spells"
nodes = Array[ExtResource("node")]([SubResource("n_stealth"), SubResource("n_heal")])
